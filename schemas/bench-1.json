{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tipoLi5890/unity-dev-skills/main/schemas/bench-1.json",
  "title": "bench/1 — one version's rig readings, to compare with another",
  "description": "What character-autorig's `rig_exam.py bench` writes and `rig_exam.py compare` reads: the rig exam's summary (exam/1's report summary, or null) and, per real character, every gate its autorig.py stages read, with the margin, plus the stability of `autorig.py all --repeat`. The required keys are what compare reads; every level stays open to extra keys.",
  "type": "object",
  "required": [
    "schema",
    "exam",
    "real"
  ],
  "properties": {
    "schema": {
      "const": "bench/1"
    },
    "tool": {
      "type": "string"
    },
    "exam": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/summary"
        }
      ],
      "description": "the exam's summary, or null (no exam, or no case scored)"
    },
    "real": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "stages",
          "worst_margin"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "out": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "stages": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/stage"
            },
            "description": "per autorig.py step (`deform` the reading after the repair ladder)"
          },
          "stability": {
            "type": [
              "object",
              "null"
            ],
            "description": "OUT/autorig.stability.json (gate/1), or null without --repeat"
          },
          "worst_margin": {
            "type": [
              "number",
              "null"
            ],
            "description": "the least margin over the stages' gates; null when none carries one"
          },
          "repair": {
            "type": "object",
            "required": [
              "chosen"
            ],
            "description": "what autorig.py's repair ladder did (0.46 and later; a bench without it reads to compare as repair status unknown): `chosen` the run OUT/autorig.all.json stands for, `runs` each `all --repeat` run (null without --repeat)",
            "properties": {
              "chosen": {
                "$ref": "#/$defs/repair_run"
              },
              "runs": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "required": [
                      "n",
                      "repaired"
                    ],
                    "properties": {
                      "n": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "chosen": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "read": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "runs whose own summary was found"
                      },
                      "repaired": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "runs where the ladder made an attempt"
                      },
                      "per_run": {
                        "type": "array",
                        "items": {
                          "allOf": [
                            {
                              "$ref": "#/$defs/repair_run"
                            },
                            {
                              "type": "object",
                              "properties": {
                                "run": {
                                  "type": "string"
                                }
                              }
                            }
                          ]
                        }
                      },
                      "used": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "runs whose bind is the repair"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "made_with": {
      "type": "object",
      "properties": {
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "scripts": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": [
        "pass",
        "gates"
      ],
      "properties": {
        "pass": {
          "type": "boolean"
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "pass",
              "margin"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "limit": {},
              "pass": {
                "type": "boolean"
              },
              "margin": {
                "type": [
                  "number",
                  "null"
                ],
                "description": "gate/1's margin (schemas/README.md); null when the gate has none"
              }
            }
          }
        }
      }
    },
    "names": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "description": "the rig exam's summary, as exam/1's report carries it (schemas/exam-1.json, $defs/summary): keep the two equal",
      "required": [
        "tol",
        "outcomes",
        "false_pass",
        "false_fail",
        "faults_caught",
        "faults_slipped",
        "control_fail",
        "fingers_right"
      ],
      "properties": {
        "tol": {
          "type": "number"
        },
        "outcomes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/names"
          }
        },
        "false_pass": {
          "$ref": "#/$defs/names"
        },
        "false_fail": {
          "$ref": "#/$defs/names"
        },
        "faults_caught": {
          "$ref": "#/$defs/names"
        },
        "faults_slipped": {
          "$ref": "#/$defs/names"
        },
        "control_fail": {
          "$ref": "#/$defs/names"
        },
        "fingers_right": {
          "type": "integer",
          "minimum": 0
        },
        "fingers_cases": {
          "type": "integer",
          "minimum": 0
        },
        "volume": {
          "type": "object"
        }
      }
    },
    "repair_run": {
      "type": "object",
      "required": [
        "result",
        "fired"
      ],
      "properties": {
        "result": {
          "type": "string",
          "description": "the ladder's result (passed, exhausted, error, not_applicable; after a near-limit ladder kept_repair or kept_original); none: deform ran and passed, no ladder; not_reached: deform did not run; unknown: the run's summary is gone"
        },
        "fired": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "an attempt was made; null when unknown"
        },
        "attempts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "hinges": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rungs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "hinges",
              "amount"
            ],
            "properties": {
              "hinges": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "amount": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "cross_side": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "the bones the cross-side move gave weight from"
              },
              "passed": {
                "type": "boolean"
              }
            }
          }
        },
        "trigger": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "failed",
            "near_limit",
            null
          ],
          "description": "why the ladder ran: a failed deform gate, or a passing elbow or knee volume within autorig.py --repair-near of its limit"
        },
        "used": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "the bind taken on is a repair (passed or kept_repair); null when unknown"
        }
      }
    }
  }
}
