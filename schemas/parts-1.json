{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tipoLi5890/unity-dev-skills/main/schemas/parts-1.json",
  "title": "parts/1 — a character's parts plan",
  "description": "Which parts a character is built from: the anchor (the whole-body mesh, always generated first) and the parts generated or split and registered onto it. Geometry is in the anchor GLB's own frame (glTF: +Y up, front = the multi-view front). Paths are relative to the plan file. part_math.py plan writes the anchor measurements, boxes and seam heights; part_views.py writes views.dir, views.sheet, views.colours and generated; a person edits tier, preset, seam.mode, prompt_hint, budget_share and split.delta. Rules the schema cannot say (one anchor, the tier's region set, no Large on a part that carries hair, budget shares summing to at most 1, the anchor hash) are checked by the tools.",
  "type": "object",
  "required": ["schema", "character", "tier", "parts"],
  "properties": {
    "schema": {"const": "parts/1"},
    "character": {"$ref": "#/$defs/name"},
    "tier": {"enum": ["whole", "three", "fine", "custom"], "description": "whole = the demo, no parts; three = body, head, hair; fine = three plus hand.L and/or hand.R (eyeballs come from eye_fit.py, not a plan part; eyes and accessory parts are refused for now); custom is a reserved name, refused by the tools"},
    "anchor": {
      "type": "object",
      "required": ["glb", "glb_sha256", "frame", "head_height", "neck"],
      "properties": {
        "glb": {"type": "string", "minLength": 1},
        "painted_glb": {
     "type": "string",
     "description": "the anchor repainted by mesh-texture-paint (part_math.py plan --painted); the assembly takes it over glb"
    },
    "glb_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "a plan whose anchor no longer matches is refused: run plan again"},
        "frame": {
          "type": "object",
          "required": ["units_per_px", "offset_px"],
          "properties": {
            "units_per_px": {"type": "number", "exclusiveMinimum": 0},
            "offset_px": {"$ref": "#/$defs/per_view", "description": "the pixel the anchor origin projects to, per view"},
            "iou": {"$ref": "#/$defs/per_view"}
          }
        },
        "bbox_min": {"$ref": "#/$defs/vec3"},
        "bbox_max": {"$ref": "#/$defs/vec3"},
        "head_height": {"type": "number", "exclusiveMinimum": 0},
        "neck": {
          "type": "object",
          "required": ["band", "axis_xz", "radius", "collar"],
          "properties": {
            "band": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
            "axis_xz": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
            "radius": {"type": "number", "exclusiveMinimum": 0},
            "collar": {"type": "boolean"},
            "collar_top": {"type": ["number", "null"]},
            "covered": {
              "type": ["object", "null"],
              "description": "the ring goes on below the band, no wider, with loops nested in it (a stand collar fused to the jaw): the band sits on the jaw; part_bottom_y reaches foot_y; nape_z places the side views' neck prior",
              "properties": {"to_y": {"type": "number"}, "foot_y": {"type": "number"}, "nested_rows": {"type": "integer"},
                             "rows": {"type": "integer"}, "children_max": {"type": "integer"}, "nape_z": {"type": "number"}}
            }
          }
        }
      }
    },
    "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}}
  },
  "allOf": [
    {"if": {"properties": {"tier": {"not": {"const": "whole"}}}}, "then": {"required": ["anchor"]}}
  ],
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "per_view": {
      "type": "object",
      "properties": {"front": {}, "left": {}, "back": {}, "right": {}},
      "additionalProperties": false
    },
    "box": {"type": "array", "items": {"type": "integer"}, "minItems": 4, "maxItems": 4},
    "part": {
      "type": "object",
      "required": ["name", "source", "region"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "source": {"enum": ["anchor", "generate", "split"]},
        "region": {"enum": ["body", "head", "hair", "hand.L", "hand.R", "eyes", "accessory"]},
        "from": {"$ref": "#/$defs/name", "description": "source: split only, a part whose source is generate"},
        "preset": {"enum": ["Small", "Medium", "Compact", "Large", "Template", "Showcase"]},
        "prompt_hint": {"type": "string"},
        "prompt_hint_back": {"type": "string", "description": "the back view's own hint (what the back shows: a cap's band, a ponytail); the back view never takes prompt_hint"},
        "budget_share": {"type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "a fraction of the class's 3D budgets row, never a triangle count"},
        "region_box": {
          "type": "object",
          "properties": {"y_min": {"type": "number"}, "y_max": {"type": "number"}}
        },
        "seam": {
          "type": "object",
          "properties": {
            "mode": {"enum": ["overlap", "bridge", "none"], "description": "none is for fine add-ons (accessories)"},
            "cut_y": {"type": "number"},
            "part_bottom_y": {"type": "number"},
            "margin_frac": {"type": "number", "minimum": 0},
            "depth_r_fore": {"type": "number", "exclusiveMinimum": 0, "description": "a hand: its bottom plane lies this many forearm radii past the wrist plane, inside the sleeve"}
          }
        },
        "views": {
          "type": "object",
          "properties": {
            "source": {"enum": ["clean-views", "sheet"], "description": "clean-views = crops of the S2 views; sheet = a drawn part sheet (reserved)"},
            "sheet": {"type": "string"},
            "dir": {"type": "string"},
            "box_side_px": {"type": "integer", "minimum": 8},
            "boxes": {
              "type": "object",
              "properties": {"front": {"$ref": "#/$defs/box"}, "left": {"$ref": "#/$defs/box"},
                             "back": {"$ref": "#/$defs/box"}, "right": {"$ref": "#/$defs/box"}},
              "additionalProperties": false
            },
            "keep": {"$ref": "#/$defs/per_view"},
            "hidden": {
              "type": "object",
              "description": "a hand: the view the body hides is the mirror of the opposite side view (its box mirrored about the frame centre, its redraw flipped)",
              "required": ["view", "mirror_of"],
              "properties": {"view": {"enum": ["left", "right"]}, "mirror_of": {"enum": ["left", "right"]}}
            },
            "colours": {
              "type": ["object", "null"],
              "properties": {"hair": {"$ref": "#/$defs/hex"}, "skin": {"$ref": "#/$defs/hex"}}
            },
            "hanging": {
              "type": "object",
              "description": "part_math.py plan: hair hanging below the cut outside the neck (a ponytail), kept in the views down to part_bottom_y",
              "properties": {"pieces": {"type": "array", "items": {"type": "object"}}, "masks": {"$ref": "#/$defs/per_view"}}
            },
            "accepted": {
              "type": "object",
              "description": "part_views.py --accept: per view, a near miss a person signed off",
              "additionalProperties": {
                "type": "object",
                "required": ["seed", "by", "gates", "redraw_sha256"],
                "properties": {"seed": {"type": "integer"}, "by": {"type": "string", "minLength": 1}, "note": {"type": "string"},
                               "gates": {"type": "object"}, "redraw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                               "at": {"type": "string"}}
              }
            }
          }
        },
        "generated": {
          "type": "object",
          "properties": {"glb": {"type": "string"}, "painted": {"type": "string", "description": "the part repainted by mesh-texture-paint; absent, the assembly takes paint/<part>/<stem>_painted.glb when it exists"},
                         "paint": {"type": "object", "description": "set when every paint try failed a gate: the part keeps its generated texture", "properties": {"status": {"enum": ["unpainted"]}, "reason": {"type": "string"}, "report": {"type": "string"}}},
                         "attempts": {"type": "array", "description": "a hand: each generation job (its GLB, the gate exit and the failed gates); a failed registration or finger gate runs the job again with every sampler seed moved", "items": {"type": "object"}}}
        },
        "split": {
          "type": "object",
          "properties": {"method": {"enum": ["scalp-radius"]}, "delta": {"type": "number", "exclusiveMinimum": 0}}
        },
        "wrist": {
          "type": "object",
          "description": "a hand (tier fine), measured on the anchor by part_math.py plan: the forearm axis (toward the shoulder), the wrist plane through the sleeve's cuff (rim, normal), the part's bottom plane inside the sleeve, the forearm and sleeve radii",
          "required": ["axis", "rim", "normal", "bottom", "r_fore", "r_sleeve"],
          "properties": {
            "tip": {"$ref": "#/$defs/vec3"},
            "axis": {"$ref": "#/$defs/vec3"},
            "rim": {"$ref": "#/$defs/vec3"},
            "normal": {"$ref": "#/$defs/vec3"},
            "bottom": {"$ref": "#/$defs/vec3"},
            "r_fore": {"type": "number", "exclusiveMinimum": 0},
            "r_sleeve": {"type": "number", "exclusiveMinimum": 0},
            "rim_threshold": {"type": "number", "exclusiveMinimum": 0},
            "plane": {"enum": ["fitted", "perpendicular"]},
            "tilt_deg": {"type": "number", "minimum": 0},
            "sectors": {"type": "integer", "minimum": 0}
          }
        },
        "attach": {
          "type": "object",
          "description": "tier fine: replace = the part replaces the anchor's region (hands); add = it is added (accessories)",
          "required": ["mode"],
          "properties": {"mode": {"enum": ["replace", "add"]}, "bone": {"type": "string"}}
        }
      },
      "allOf": [
        {"if": {"properties": {"source": {"const": "split"}}, "required": ["source"]}, "then": {"required": ["from"]}},
        {"if": {"properties": {"source": {"const": "generate"}}, "required": ["source"]}, "then": {"required": ["preset"]}}
      ]
    },
    "hex": {"type": "string", "pattern": "^#[0-9a-f]{6}$"}
  }
}
